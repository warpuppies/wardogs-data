# Copy to .env (gitignored) and fill in your paths. Values are not expanded: no ~ or $HOME, use absolute paths.
WARDOGS_INSTALL_DIR=/mnt/c/Games/Steam/steamapps/common/Wardogs
# Provide the key inline, or point to a file that contains it (not committed).
WARDOGS_AES_KEY_FILE=/path/to/aes.key
WARDOGS_USMAP=/path/to/game.usmap
# Only needed if dotnet is not on your PATH.
DOTNET_ROOT=/path/to/.dotnet
